# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/specforge?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-jwt-key-generate-with-openssl"

# Encryption (AES-256 for external tokens)
ENCRYPTION_KEY="32-character-random-hex-string-here"

# AI & Transcription APIs
AI_LLM_API_KEY="your-llm-api-key"
AI_TRANSCRIPTION_API_KEY="your-whisper-or-deepgram-api-key"

# Storage (Cloudinary or Supabase Storage)
STORAGE_API_KEY="your-storage-key"
STORAGE_SECRET="your-storage-secret"
STORAGE_BUCKET="specforge-uploads"

# Email (Resend)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="SpecForge <noreply@specforge.app>"

# Telemetry & Monitoring
NEXT_PUBLIC_POSTHOG_KEY="phc_your_key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
SENTRY_DSN="https://your-sentry-dsn"

